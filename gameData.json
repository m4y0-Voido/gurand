<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>Speed & Range Preview</title>
<style>
  body {
    margin: 0;
    background: #111;
    color: white;
    font-family: sans-serif;
    overflow: hidden;
  }
  #ui {
    position: fixed;
    top: 10px;
    left: 10px;
    background: rgba(0,0,0,0.6);
    padding: 10px;
    border-radius: 8px;
  }
  input {
    width: 80px;
  }
</style>
</head>
<body>

<div id="ui">
  <div>
    SPD（移動速度）:
    <input type="number" id="spd" value="300">
  </div>
  <div>
    AE（攻撃範囲）:
    <input type="number" id="ae" value="300">
  </div>
  <p>WASDで移動 / クリックで位置変更</p>
</div>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener("resize", resize);
resize();

let player = {
  x: canvas.width / 2,
  y: canvas.height / 2
};

// 入力取得
const spdInput = document.getElementById("spd");
const aeInput = document.getElementById("ae");

// キー入力
const keys = {};
window.addEventListener("keydown", e => keys[e.key.toLowerCase()] = true);
window.addEventListener("keyup", e => keys[e.key.toLowerCase()] = false);

// クリック移動
canvas.addEventListener("click", e => {
  player.x = e.clientX;
  player.y = e.clientY;
});

// 更新
function update() {
  const SPD = Number(spdInput.value) || 0;
  
  // SPD → 実際の移動速度に変換（調整ポイント）
  const speed = SPD * 0.1;

  if (keys["w"]) player.y -= speed;
  if (keys["s"]) player.y += speed;
  if (keys["a"]) player.x -= speed;
  if (keys["d"]) player.x += speed;
}

// 描画
function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const AE = Number(aeInput.value) || 0;

  // 攻撃範囲
  ctx.beginPath();
  ctx.arc(player.x, player.y, AE, 0, Math.PI * 2);
  ctx.strokeStyle = "cyan";
  ctx.lineWidth = 2;
  ctx.stroke();

  ctx.fillStyle = "cyan";
  ctx.fillText("AE: " + AE, player.x + AE - 60, player.y);

  // プレイヤー
  ctx.beginPath();
  ctx.arc(player.x, player.y, 10, 0, Math.PI * 2);
  ctx.fillStyle = "white";
  ctx.fill();

  ctx.fillStyle = "white";
  ctx.fillText("SPD: " + spdInput.value, 20, canvas.height - 20);
}

// ループ
function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

loop();
</script>

</body>
</html>
